{
  "lastChangelogVersion": "0.78.0",
  "defaultProvider": "hermes-brain",
  "defaultModel": "hermes-brain",
  "theme": "rnk-dark",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 30000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 1,
    "baseDelayMs": 1000,
    "provider": {
      "timeoutMs": 1800000,
      "maxRetries": 0,
      "maxRetryDelayMs": 10000
    }
  },
  "subagents": {
    "agentOverrides": {
      "scout": {
        "defaultContext": "fresh",
        "thinking": "low"
      },
      "researcher": {
        "defaultContext": "fresh",
        "thinking": "medium"
      },
      "context-builder": {
        "defaultContext": "fresh",
        "thinking": "medium"
      },
      "planner": {
        "defaultContext": "fresh",
        "thinking": "high"
      },
      "reviewer": {
        "defaultContext": "fresh",
        "thinking": "high",
        "tools": ["read", "grep", "find", "ls", "bash", "contact_supervisor"]
      },
      "delegate": {
        "defaultContext": "fresh",
        "thinking": "medium"
      },
      "worker": {
        "defaultContext": "fork",
        "thinking": "high"
      },
      "oracle": {
        "defaultContext": "fork",
        "thinking": "high"
      }
    }
  },
  "extensions": [
    "extensions/workflow-guard/index.ts",
    "extensions/hermes-brain-provider/index.ts"
  ],
  "themes": [
    "themes/rnk-dark.json"
  ],
  "packages": [
    "npm:@juicesharp/rpiv-todo",
    "npm:context-mode",
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-lens",
    "npm:pi-verify"
  ]
}
