{
  "lastChangelogVersion": "0.78.0",
  "defaultProvider": "hermes-brain",
  "defaultModel": "hermes-brain",
  "theme": "rnk-dark",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 30000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 1,
    "baseDelayMs": 1000,
    "provider": {
      "timeoutMs": 1800000,
      "maxRetries": 0,
      "maxRetryDelayMs": 10000
    }
  },
  "extensions": [
    "extensions/hermes-brain-provider/index.ts"
  ],
  "themes": [
    "themes/rnk-dark.json"
  ],
  "packages": [
    "npm:@juicesharp/rpiv-todo",
    "npm:context-mode",
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-lens",
    "npm:pi-verify"
  ]
}
